@model BookAppointmentViewModel
@{ ViewData["Title"] = "Book Appointment"; }
<div class="container py-4" style="max-width:820px">
    <h3 class="mb-1">Book an appointment</h3>
    <p class="text-muted">Pick a doctor and a date, then choose one of the free time slots.</p>
    <div class="card"><div class="card-body">
        <form asp-action="Book" method="post" id="bookForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <div class="row g-3">
                @if (Model.IsAdmin)
                {
                    <div class="col-12">
                        <label asp-for="PatientId" class="form-label"></label>
                        <select asp-for="PatientId" asp-items="Model.Patients" class="form-select"><option value="">-- Select patient --</option></select>
                        <span asp-validation-for="PatientId" class="text-danger small"></span>
                    </div>
                }
                <div class="col-md-7">
                    <label asp-for="DoctorId" class="form-label"></label>
                    <select asp-for="DoctorId" asp-items="Model.Doctors" class="form-select" id="DoctorId"><option value="">-- Select doctor --</option></select>
                    <span asp-validation-for="DoctorId" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="bookDate">Date</label>
                    <input type="date" id="bookDate" name="Date" class="form-control" min="@Model.MinDate" max="@Model.MaxDate" value="@Model.Date?.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="Date" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label">Available time slots</label>
                    <div id="slotBox" class="slot-box"><span class="text-muted">Choose a doctor and date to see time slots.</span></div>
                    <input type="hidden" id="StartTime" name="StartTime" value="@Model.StartTime?.ToString("HH:mm")" />
                    <span asp-validation-for="StartTime" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Reason" class="form-label"></label>
                    <textarea asp-for="Reason" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Reason" class="text-danger small"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-clinic"><i class="bi bi-calendar-check"></i> Confirm booking</button>
                <a asp-action="Index" class="btn btn-outline-clinic">My appointments</a>
            </div>
        </form>
    </div></div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var slotsUrl = '@Url.Action("Slots", "Appointments")';
            var doctor = document.getElementById('DoctorId');
            var date = document.getElementById('bookDate');
            var box = document.getElementById('slotBox');
            var hidden = document.getElementById('StartTime');

            function note(text, cls) { box.innerHTML = '<span class="' + (cls || 'text-muted') + '"></span>'; box.firstChild.textContent = text; }

            function render(d) {
                if (d.isPast) return note('That date is in the past.', 'text-danger');
                if (d.onLeave) return note('The doctor is on leave on this date' + (d.leaveReason ? ' (' + d.leaveReason + ')' : '') + '.', 'text-danger');
                if (!d.slots.length) return note('No time slots on this date. Try another day.');
                box.innerHTML = '';
                d.slots.forEach(function (s) {
                    var b = document.createElement('button');
                    b.type = 'button';
                    b.className = 'slot-btn' + (s.booked ? ' booked' : '') + (hidden.value === s.start ? ' active' : '');
                    b.textContent = s.start + (s.booked ? ' (booked)' : '');
                    b.disabled = s.booked;
                    b.addEventListener('click', function () {
                        hidden.value = s.start;
                        box.querySelectorAll('.slot-btn').forEach(function (x) { x.classList.remove('active'); });
                        b.classList.add('active');
                    });
                    box.appendChild(b);
                });
            }

            function load() {
                if (!doctor.value || !date.value) { note('Choose a doctor and date to see time slots.'); return; }
                note('Loading slots...');
                fetch(slotsUrl + '?doctorId=' + encodeURIComponent(doctor.value) + '&date=' + encodeURIComponent(date.value), { credentials: 'same-origin' })
                    .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
                    .then(render)
                    .catch(function () { note('Could not load slots. Please try again.', 'text-danger'); });
            }

            doctor.addEventListener('change', function () { hidden.value = ''; load(); });
            date.addEventListener('change', function () { hidden.value = ''; load(); });
            load();
        })();
    </script>
}
