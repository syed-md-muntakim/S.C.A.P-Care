@{ ViewData["Title"] = "Password reset"; }
<div class="auth-wrap">
    <div class="card auth-card shadow-sm"><div class="card-body p-4 text-center">
        <i class="bi bi-check-circle hero-icon"></i>
        <h4 class="mt-2">Password updated</h4>
        <p class="text-muted">You can now sign in with your new password.</p>
        <a asp-action="Login" class="btn btn-clinic">Login</a>
    </div></div>
</div>
