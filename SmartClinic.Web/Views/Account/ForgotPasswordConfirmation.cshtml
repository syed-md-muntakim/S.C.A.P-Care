@{ ViewData["Title"] = "Check your email"; }
<div class="auth-wrap">
    <div class="card auth-card shadow-sm"><div class="card-body p-4 text-center">
        <i class="bi bi-envelope-check hero-icon"></i>
        <h4 class="mt-2">Check your email</h4>
        <p class="text-muted">If an account exists for that email, a reset link has been sent.</p>
        @if (TempData["DevResetLink"] is string link)
        {
            <div class="alert alert-warning text-start small"><strong>Development only</strong> (SMTP is added in Sprint 3):<br /><a href="@link">Open reset link</a></div>
        }
        <a asp-action="Login" class="btn btn-clinic">Back to login</a>
    </div></div>
</div>
