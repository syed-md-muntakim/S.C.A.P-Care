@model RegisterViewModel
@{
    ViewData["Title"] = "Sign Up";
    var specialties = new[] { "General Physician", "Cardiology", "Dermatology", "ENT", "Gynecology", "Neurology", "Ophthalmology", "Orthopedics", "Pediatrics", "Psychiatry", "Dentistry" };
}
<div class="auth-wrap">
    <div class="card auth-card auth-card-wide shadow-sm">
        <div class="card-body p-4">
            <h3 class="mb-1">Create your account</h3>
            <p class="text-muted">Doctors are activated after admin approval.</p>
            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label"></label>
                        <select asp-for="Role" class="form-select" id="roleSelect">
                            <option value="Patient">Patient</option>
                            <option value="Doctor">Doctor</option>
                        </select>
                    </div>
                    <div class="col-md-6" id="specialtyBox">
                        <label asp-for="Specialty" class="form-label"></label>
                        <select asp-for="Specialty" class="form-select">
                            <option value="">-- Select specialty --</option>
                            @foreach (var s in specialties) { <option value="@s">@s</option> }
                        </select>
                        <span asp-validation-for="Specialty" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6"><label asp-for="UserId" class="form-label"></label><input asp-for="UserId" class="form-control" autocomplete="username" /><span asp-validation-for="UserId" class="text-danger small"></span></div>
                    <div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
                    <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
                    <div class="col-md-6"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" /><span asp-validation-for="PhoneNumber" class="text-danger small"></span></div>
                    <div class="col-md-6"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger small"></span></div>
                    <div class="col-md-6"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
                </div>
                <button type="submit" class="btn btn-clinic w-100 mt-4">Sign Up</button>
            </form>
            <p class="text-center mt-3 mb-0 small">Already registered? <a asp-action="Login" class="link-clinic">Login</a></p>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var role = document.getElementById('roleSelect'), box = document.getElementById('specialtyBox');
            function sync() { box.style.display = role.value === 'Doctor' ? '' : 'none'; }
            role.addEventListener('change', sync); sync();
        })();
    </script>
}
