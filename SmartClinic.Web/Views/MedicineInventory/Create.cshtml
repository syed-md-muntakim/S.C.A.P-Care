@model MedicineFormViewModel
@{
    ViewData["Title"] = "Add Medicine";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="link-clinic text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i> Back to inventory
        </a>
        <h3 class="mt-2 mb-1">Add medicine</h3>
        <p class="text-muted mb-0">Enter the medicine and batch details. Opening quantity will be recorded as an initial stock movement.</p>
    </div>

    <div class="card">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <h6 class="text-uppercase text-muted small fw-bold mb-3">Medicine information</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Paracetamol" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="GenericName" class="form-label"></label>
                        <input asp-for="GenericName" class="form-control" />
                        <span asp-validation-for="GenericName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Strength" class="form-label"></label>
                        <input asp-for="Strength" class="form-control" placeholder="e.g. 500 mg" />
                        <span asp-validation-for="Strength" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DosageForm" class="form-label"></label>
                        <input asp-for="DosageForm" class="form-control" placeholder="Tablet, capsule, syrup..." />
                        <span asp-validation-for="DosageForm" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Unit" class="form-label"></label>
                        <input asp-for="Unit" class="form-control" placeholder="Tablet, bottle, strip..." />
                        <span asp-validation-for="Unit" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />
                <h6 class="text-uppercase text-muted small fw-bold mb-3">Batch and supplier</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="BatchNumber" class="form-label"></label>
                        <input asp-for="BatchNumber" class="form-control" />
                        <span asp-validation-for="BatchNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SupplierName" class="form-label"></label>
                        <input asp-for="SupplierName" class="form-control" />
                        <span asp-validation-for="SupplierName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ExpiryDate" class="form-label"></label>
                        <input asp-for="ExpiryDate" type="date" class="form-control" />
                        <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="UnitPrice" class="form-label"></label>
                        <input asp-for="UnitPrice" type="number" min="0" step="0.01" class="form-control" />
                        <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />
                <h6 class="text-uppercase text-muted small fw-bold mb-3">Initial stock</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="QuantityInStock" class="form-label"></label>
                        <input asp-for="QuantityInStock" type="number" min="0" class="form-control" />
                        <span asp-validation-for="QuantityInStock" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ReorderLevel" class="form-label"></label>
                        <input asp-for="ReorderLevel" type="number" min="0" class="form-control" />
                        <span asp-validation-for="ReorderLevel" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-clinic">Cancel</a>
                    <button type="submit" class="btn btn-clinic">
                        <i class="bi bi-check-lg me-1"></i> Save medicine
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
