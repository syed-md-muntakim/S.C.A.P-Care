@model MedicineFormViewModel
@{
    ViewData["Title"] = "Edit Medicine";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="link-clinic text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i> Back to inventory
        </a>
        <h3 class="mt-2 mb-1">Edit medicine</h3>
        <p class="text-muted mb-0">Update medicine details and reorder settings. Use Adjust Stock to change the quantity.</p>
    </div>

    <div class="card">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="GenericName" class="form-label"></label>
                        <input asp-for="GenericName" class="form-control" />
                        <span asp-validation-for="GenericName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Strength" class="form-label"></label>
                        <input asp-for="Strength" class="form-control" />
                        <span asp-validation-for="Strength" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DosageForm" class="form-label"></label>
                        <input asp-for="DosageForm" class="form-control" />
                        <span asp-validation-for="DosageForm" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Unit" class="form-label"></label>
                        <input asp-for="Unit" class="form-control" />
                        <span asp-validation-for="Unit" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BatchNumber" class="form-label"></label>
                        <input asp-for="BatchNumber" class="form-control" />
                        <span asp-validation-for="BatchNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SupplierName" class="form-label"></label>
                        <input asp-for="SupplierName" class="form-control" />
                        <span asp-validation-for="SupplierName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ExpiryDate" class="form-label"></label>
                        <input asp-for="ExpiryDate" type="date" class="form-control" />
                        <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="UnitPrice" class="form-label"></label>
                        <input asp-for="UnitPrice" type="number" min="0" step="0.01" class="form-control" />
                        <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ReorderLevel" class="form-label"></label>
                        <input asp-for="ReorderLevel" type="number" min="0" class="form-control" />
                        <span asp-validation-for="ReorderLevel" class="text-danger small"></span>
                    </div>
                </div>

                <div class="alert alert-light border mt-4 mb-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <div class="small text-muted">Current stock</div>
                        <div class="fw-semibold">@Model.QuantityInStock @Model.Unit</div>
                        <div class="small text-muted">Quantity is changed through the stock adjustment screen to preserve its audit history.</div>
                    </div>
                    <a asp-action="AdjustStock" asp-route-id="@Model.Id" class="btn btn-outline-clinic">
                        <i class="bi bi-box-seam me-1"></i> Adjust stock
                    </a>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-clinic">Cancel</a>
                    <button type="submit" class="btn btn-clinic">
                        <i class="bi bi-check-lg me-1"></i> Save changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
