@model MyQueueViewModel
@{ ViewData["Title"] = "My Token"; }
<div class="container py-4" style="max-width:820px">
    <h3 class="mb-1">My token &amp; queue</h3>
    <p class="text-muted">Your position updates automatically.</p>
    <div id="liveRegion" data-refresh-url="@Url.Action("MyTokenPartial", "Queue")">
        <partial name="_MyToken" model="Model" />
    </div>
</div>
@section Scripts { <partial name="_LiveScripts" /> }
