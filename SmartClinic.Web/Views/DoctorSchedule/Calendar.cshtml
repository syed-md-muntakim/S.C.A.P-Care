@model ScheduleIndexViewModel
@{ ViewData["Title"] = "Schedule Calendar"; }
<div class="container py-4">
    <a asp-action="Index" asp-route-doctorId="@Model.DoctorId" class="link-clinic small"><i class="bi bi-arrow-left"></i> Back to schedule list</a>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-1 mb-3">
        <div>
            <h3 class="mb-0">Calendar: @Model.DoctorName</h3>
            <span class="text-muted">Purple = working shift, grey = paused shift, red = leave</span>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="AddLeave" asp-route-doctorId="@Model.DoctorId" class="btn btn-outline-clinic">Add leave</a>
            <a asp-action="AddShift" asp-route-doctorId="@Model.DoctorId" class="btn btn-clinic">Add shift</a>
        </div>
    </div>
    <div class="card"><div class="card-body"><div id="calendar"></div></div></div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var doctorId = '@Model.DoctorId';
        var cal = new FullCalendar.Calendar(document.getElementById('calendar'), {
            initialView: 'dayGridMonth',
            firstDay: 0,
            height: 'auto',
            nowIndicator: true,
            headerToolbar: { left: 'prev,next today', center: 'title', right: 'dayGridMonth,timeGridWeek,listWeek' },
            eventTimeFormat: { hour: '2-digit', minute: '2-digit', hour12: false },
            events: function (info, success, failure) {
                fetch('/DoctorSchedule/GetEvents?doctorId=' + encodeURIComponent(doctorId) +
                      '&start=' + encodeURIComponent(info.startStr) + '&end=' + encodeURIComponent(info.endStr))
                    .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
                    .then(success).catch(failure);
            }
        });
        cal.render();
    });
</script>
}
