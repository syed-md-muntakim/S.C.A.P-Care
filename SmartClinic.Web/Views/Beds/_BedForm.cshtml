@model BedFormViewModel
<form asp-action="@(Model.Id is null ? "Create" : "Edit")" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    @if (Model.Id is not null) { <input type="hidden" asp-for="Id" /> }
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="BedNumber" class="form-label"></label>
            <input asp-for="BedNumber" class="form-control" placeholder="e.g. A-101 or C-301" />
            <span asp-validation-for="BedNumber" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Type" class="form-label"></label>
            <select asp-for="Type" class="form-select">
                <option value="Bed">Bed (ward)</option>
                <option value="Cabin">Cabin (private room)</option>
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="Ward" class="form-label"></label>
            <input asp-for="Ward" class="form-control" placeholder="e.g. General Ward A, Cabin Block" list="wardList" />
            <span asp-validation-for="Ward" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DailyRate" class="form-label"></label>
            <input asp-for="DailyRate" type="number" step="0.01" min="0" class="form-control" />
            <span asp-validation-for="DailyRate" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="Notes" class="form-label"></label>
            <input asp-for="Notes" class="form-control" placeholder="Optional (e.g. attached bathroom, oxygen outlet)" />
            <span asp-validation-for="Notes" class="text-danger small"></span>
        </div>
    </div>
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-clinic">@(Model.Id is null ? "Add" : "Save changes")</button>
        <a asp-action="Index" class="btn btn-outline-clinic">Cancel</a>
    </div>
</form>
