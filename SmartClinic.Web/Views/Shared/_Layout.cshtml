                    <span class="header-user d-none d-md-inline"><i class="bi bi-person-circle"></i> @User.Identity.Name (@dash)</span>
                }
                else
                {
                    <a class="btn btn-header" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn btn-header" asp-controller="Account" asp-action="Register">Sign Up</a>
                }
                <button type="button" id="themeToggle" class="btn btn-header" title="Toggle theme" aria-label="Toggle theme"><i class="bi bi-moon-stars"></i></button>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-header"><i class="bi bi-box-arrow-right"></i> Logout</button>
                    </form>
